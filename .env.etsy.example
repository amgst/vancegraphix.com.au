# Etsy API Credentials (from https://www.etsy.com/developers)
# ⚠️ KEEP THIS FILE PRIVATE - NEVER COMMIT TO GIT
# Add this to .gitignore: .env.local, .env.*.local

# Etsy App Credentials
VITE_ETSY_API_KEY=your_app_id_here
VITE_ETSY_API_SECRET=your_api_secret_here

# Your Etsy Shop Information
VITE_ETSY_SHOP_ID=your_shop_id_here

# OAuth Access Token (get from Etsy Developer Settings or OAuth flow)
# This should ideally be stored in a secure backend, not in the frontend
VITE_ETSY_ACCESS_TOKEN=your_oauth_access_token_here

# Example values (REPLACE WITH YOUR ACTUAL CREDENTIALS):
# VITE_ETSY_API_KEY=abc123def456ghi789
# VITE_ETSY_SHOP_ID=12345678
# VITE_ETSY_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
