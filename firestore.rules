rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing admin access uses Firebase Authentication.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    // Public website content; customer records are deliberately excluded.
    match /{collection}/{id} {
      allow read: if collection in ['blog_posts', 'page_media', 'portfolios',
        'print_portfolios', 'products', 'readySites', 'service_categories',
        'settings', 'testimonials', 'tools'];
      // Visitors can submit forms, but cannot list/read/change submissions.
      allow create: if collection in ['contact_messages', 'project_inquiries',
        'job_applications', 'store_orders']
        && request.resource.data.status == 'new'
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.createdAt == request.time;
    }
  }
}
